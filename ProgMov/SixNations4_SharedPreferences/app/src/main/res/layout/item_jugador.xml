<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila del ListView: nombre | país | puntos | bandera.
     El adaptador lo "infla" una vez por cada jugador. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="70dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:layout_marginEnd="2dp"
        android:background="@color/celda_oscura"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvPais"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginEnd="2dp"
        android:background="@color/celda_oscura"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="@color/texto_claro"
        android:textSize="15sp"
        android:textStyle="italic"/>

    <TextView
        android:id="@+id/tvPuntos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/celda_media"
        android:gravity="center"
        android:textColor="@color/texto_claro"
        android:textSize="11sp"/>

    <ImageView
        android:id="@+id/imgvBandera"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="6dp"
        android:scaleType="fitCenter"/>

</LinearLayout>
